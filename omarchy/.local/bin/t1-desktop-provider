#!/usr/bin/env bash
# Desktop provider for the t1bridge Touch Bar renderer (desktop provider v1).
# Gives the Touch Bar volume and mute controls via PipeWire (wpctl), and media
# controls when playerctl is installed. Selected by T1BRIDGE_DESKTOP_PROVIDER in
# ~/.config/systemd/user/t1-touchbar.service.d/provider.conf.
#
# Contract: invoked as `t1-desktop-provider v1 <operation> [arg]`, no shell,
# 500 ms deadline, at most 128 bytes of stdout. Exit non-zero to reject.
set -euo pipefail

SINK=@DEFAULT_AUDIO_SINK@
CAP_AUDIO=1
CAP_MEDIA=2

[[ ${1:-} == v1 ]] || exit 2
op=${2:-}

have_playerctl() { command -v playerctl >/dev/null 2>&1; }

status() {
    local caps=$CAP_AUDIO line vol muted=0
    have_playerctl && caps=$((caps | CAP_MEDIA))

    # e.g. "Volume: 0.35" or "Volume: 0.35 [MUTED]"; can exceed 1.0 when boosted.
    line=$(wpctl get-volume "$SINK")
    [[ $line == *MUTED* ]] && muted=1
    vol=$(awk '{ v = int($2 * 100 + 0.5); if (v > 100) v = 100; print v }' <<<"$line")

    printf 'T1BRIDGE-DESKTOP 1 %d %d %d\n' "$caps" "$vol" "$muted"
}

case $op in
    status)
        status
        ;;
    set-volume)
        level=${3:-}
        [[ $level =~ ^[0-9]+$ ]] && ((level <= 100)) || exit 2
        wpctl set-volume "$SINK" "${level}%"
        ;;
    toggle-mute)
        wpctl set-mute "$SINK" toggle
        ;;
    media-previous | media-play-pause | media-next)
        have_playerctl || exit 1
        case $op in
            media-previous) playerctl previous ;;
            media-play-pause) playerctl play-pause ;;
            media-next) playerctl next ;;
        esac
        ;;
    *)
        # show-display-brightness, show-keyboard-backlight and
        # notify-renderer-fallback need capability bits we don't advertise.
        exit 1
        ;;
esac
